# Copy to demo-ui/.env and fill in. `npm start` reads it and passes the values to the services.
# Variables already set in the shell take precedence. Keys may be pasted with or without 0x.

# --- Required for the full demo -------------------------------------------------------------

# Facilitator's settlement key: submits transferWithAuthorization and pays the gas.
# Fund its address with a little Sepolia ETH (0.05 ETH is plenty for hundreds of payments).
# Without it payments are still verified and served, but never settled on-chain.
# Falls back to facilitator/.env.
FACILITATOR_PRIVATE_KEY=

# --- Payment token ----------------------------------------------------------------------------

# Any EIP-3009 token on Sepolia; its name, EIP-712 version, symbol and decimals are read from the
# contract. Empty = Circle's Sepolia USDC (0x1c7D4B196Cb0C7B01d743Fbc6116a902379C7238): fund the
# agent at https://faucet.circle.com (the wallet page's "충전" button opens it).
# DemoCoin: 0x025311Ca250150E9c3684b614566c9f187a47e16 (only its owner can hand it out, see below).
TOKEN_ADDRESS=

# DemoCoin only: key of the account holding DEMO, normally the token owner/deployer
# 0x0E79409e5f2b822d2046cC28E99FF6b411B3beBE. The wallet page's "충전" button then sends the
# agent 1 DEMO from it (needs Foundry's `cast`). Falls back to coin-contract/.env's
# DEPLOYER_PRIVATE_KEY.
TOKEN_OWNER_PRIVATE_KEY=

# --- Optional ---------------------------------------------------------------------------------

# Address that receives the payments, shown as the seller's settlement wallet. Only the address
# is needed, no key (default: 0x0E79409e5f2b822d2046cC28E99FF6b411B3beBE).
PAY_TO_ADDRESS=

# Sepolia RPC used by the Facilitator and this server (default: public node, rate-limited).
ETHEREUM_RPC_URL=

# Agent Wallet secrets. The defaults are fine for a local demo. Changing KEYSTORE_PASSPHRASE
# after the agent wallet exists makes demo-ui/.keystore unreadable: delete that folder to start
# with a new (empty) agent wallet.
APPROVAL_TOKEN_SECRET=
KEYSTORE_PASSPHRASE=
